---
import { SITE, url } from '../lib/config';
import type { TgPost } from '../lib/telegram';

interface Props {
  posts: TgPost[];
  limit?: number;
}
const { posts, limit = 3 } = Astro.props;
const shown = posts.slice(0, limit);

function timeAgo(d: Date): string {
  const days = Math.floor((Date.now() - d.getTime()) / 86400000);
  if (days === 0) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  return months === 1 ? '1mo ago' : `${months}mo ago`;
}

// One standard block per post: blank-line runs collapsed, bare URLs shown as their domain.
function clean(s: string): string {
  return s
    .replace(/https?:\/\/(?:www\.)?([^\s/]+)\S*/g, '$1')
    .replace(/[ \t]+\n/g, '\n')
    .replace(/\n{2,}/g, '\n')
    .trim();
}
---

{
  shown.length > 0 ? (
    <div class="tg-grid">
      {shown.map((p) => (
        <a class="card tg-card reveal" href={p.link} target="_blank" rel="noopener">
          <div class="tg-head">
            <span class="tg-badge">
              <img class="tg-ava" src={url('images/avatar.jpg')} alt="" width="28" height="28" loading="lazy" />
              @{SITE.telegram}
            </span>
            <span class="tg-time">{timeAgo(p.date)}</span>
          </div>
          {p.photo && (
            <div class="tg-photo">
              <img src={p.photo} alt="" loading="lazy" referrerpolicy="no-referrer" />
            </div>
          )}
          {p.text && <p class={`tg-text ${p.photo ? 'has-photo' : ''}`}>{clean(p.text)}</p>}
          <div class="tg-foot">
            {p.views && <span class="tg-views">{p.views} views</span>}
            <span class="tg-open">Open in Telegram →</span>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="card tg-empty reveal">
      <p class="tg-empty-title">Live feed from Telegram</p>
      <p class="tg-empty-sub">
        Daily investing notes and the occasional slice of life — follow along on Telegram.
      </p>
      <a class="btn btn-primary" href={SITE.telegramUrl} target="_blank" rel="noopener">
        Open @{SITE.telegram}
      </a>
    </div>
  )
}

<style>
  .tg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .tg-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    min-width: 0;
    color: inherit;
  }
  .tg-card:hover {
    color: inherit;
  }
  .tg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tg-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #2aabee;
    font-variant-numeric: tabular-nums;
  }
  .tg-ava {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }
  .tg-time {
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .tg-photo {
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--bg-subtle);
  }
  .tg-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tg-text {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text);
    white-space: pre-line;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tg-text.has-photo {
    -webkit-line-clamp: 3;
  }
  .tg-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .tg-views {
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .tg-open {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
  }
  .tg-empty {
    padding: 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .tg-empty-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
  }
  .tg-empty-sub {
    color: var(--text-secondary);
    max-width: 40ch;
    margin-bottom: 8px;
  }
</style>
