---
import Base from '../layouts/Base.astro';
import TelegramStrip from '../components/TelegramStrip.astro';
import { SITE, url } from '../lib/config';
import { fetchTelegramPosts } from '../lib/telegram';

const posts = await fetchTelegramPosts(9);
---

<Base
  title="Telegram"
  description="Daily investing notes and lifestyle posts on the Invest Sema Telegram channel."
>
  <section class="page-hero">
    <div class="container tg-hero">
      <a class="tg-avatar reveal" href={SITE.telegramUrl} target="_blank" rel="noopener">
        <img class="tg-avatar-photo" src={url('images/avatar.jpg')} alt="Sema" width="112" height="112" />
        <img class="tg-avatar-badge" src={url('logos/telegram.png')} alt="" width="32" height="32" />
      </a>
      <h1 class="reveal">@{SITE.telegram}</h1>
      <p class="page-sub reveal">
        The daily stream: what I'm watching, quick market reactions, and the life around
        investing. Long reads and setups get announced here first.
      </p>
      <div class="tg-cta reveal">
        <a class="btn btn-primary" href={SITE.telegramUrl} target="_blank" rel="noopener">
          Subscribe on Telegram
        </a>
        <a class="btn btn-ghost" href={SITE.xUrl} target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
          Follow @{SITE.x} on X
        </a>
      </div>
    </div>
  </section>

  <section class="container feed-wrap">
    <h2 class="feed-title reveal">Latest posts</h2>
    <TelegramStrip posts={posts} limit={9} />
    <p class="feed-note reveal">
      The feed refreshes with every site update — for the live channel, open Telegram.
    </p>
  </section>
</Base>

<style>
  .tg-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .page-hero {
    padding: 88px 0 48px;
  }
  .tg-hero {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .tg-avatar {
    position: relative;
    display: block;
    width: 112px;
    height: 112px;
    margin-bottom: 4px;
    transition: transform 0.4s ease;
  }
  .tg-avatar:hover {
    transform: translateY(-2px);
  }
  .tg-avatar-photo {
    width: 112px;
    height: 112px;
    display: block;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }
  .tg-avatar-badge {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 3px solid var(--bg);
    background: var(--bg);
    box-sizing: content-box;
  }
  .tg-hero h1 {
    font-size: clamp(34px, 5vw, 52px);
  }
  .page-sub {
    font-size: 18px;
    color: var(--text-secondary);
    max-width: 52ch;
    line-height: 1.55;
  }
  .feed-wrap {
    padding-bottom: 40px;
  }
  .feed-title {
    font-size: 28px;
    margin-bottom: 24px;
  }
  .feed-note {
    margin-top: 24px;
    font-size: 13.5px;
    color: var(--text-muted);
  }
</style>
